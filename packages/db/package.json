{
  "name": "@gateway/db",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@gateway/core": "workspace:*",
    "pg": "8.13.0"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "typescript": "5.6.3",
    "tsx": "4.19.1",
    "vitest": "2.1.3"
  }
}
