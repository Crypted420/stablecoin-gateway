# Docker supplies its own internal DATABASE_URL and REDIS_URL. Keep these
# localhost values for people running the applications without Docker.
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379
API_PORT=4000
LOG_LEVEL=info
# REQUIRED: make this a long private value. It unlocks the local admin page.
ADMIN_API_KEY=
ENFORCE_HTTPS=false
CORS_ORIGIN=http://localhost:5173
WORKER_CONTROL_URL=http://127.0.0.1:4100
WORKER_CONTROL_HOST=127.0.0.1

# REQUIRED: a dedicated 12- or 24-word wallet recovery phrase. Every invoice
# address is derived from it. Never use your personal wallet phrase.
WALLET_MNEMONIC=

# "alchemy" receives transfers through signed Address Activity webhooks. "rpc"
# uses the legacy HTTP polling listener and scanner.
CHAIN_DETECTION_MODE=rpc

# Low-volume HTTPS RPC access remains required in either mode for confirmation
# depth, canonical block checks and one bounded startup recovery scan. One URL is
# enough; optional comma-separated *_RPC_URLS adds redundancy.
# REQUIRED in both detection modes. HTTPS URLs only; WebSocket URLs are not used.
POLYGON_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URLS=
BSC_RPC_URLS=

# Required only when CHAIN_DETECTION_MODE=alchemy. Create one Address Activity
# webhook per network, both pointing to /api/webhooks/alchemy on the public API.
# The auth token is the Notify API token; signing keys are unique per webhook.
ALCHEMY_NOTIFY_AUTH_TOKEN=
ALCHEMY_POLYGON_WEBHOOK_ID=
ALCHEMY_BSC_WEBHOOK_ID=
ALCHEMY_POLYGON_SIGNING_KEY=
ALCHEMY_BSC_SIGNING_KEY=

POLYGON_CONFIRMATIONS=60
BSC_CONFIRMATIONS=15
# Pending payments share one chain-head read per network on each poll.
CONFIRMATION_POLL_INTERVAL_MS=5000
# Blocks re-scanned at startup to recover anything missed while down, and the
# eth_getLogs window per request. Free RPC tiers cap the window hard (often 10);
# the scanner narrows itself automatically if the provider objects.
CHAIN_BACKFILL_BLOCKS=200
CHAIN_TARGET_BACKFILL_BLOCKS=20
CHAIN_SCAN_RANGE_BLOCKS=10
CHAIN_SCAN_INTERVAL_MS=15000

TREASURY_ADDRESS=
SWEEP_GAS_PRIVATE_KEY=
SWEEP_CONFIRMATIONS=1
SWEEP_GAS_BUFFER_BPS=13000
SWEEP_MAX_BATCH=50

FX_URL=https://api.fiampayments.com/api/quote
FX_QUOTE_TTL_SECONDS=120

# REQUIRED for bank lookup and naira payout. Begin with a Paystack test key.
PAYSTACK_SECRET_KEY=
PAYOUT_STATUS_POLL_INTERVAL_MS=10000
# Only required if a merchant webhook URL is configured.
WEBHOOK_SIGNING_SECRET=

# Real-chain evaluation runner (preflight only unless EVAL_LIVE=true)
EVAL_API_URL=http://localhost:4000
EVAL_NETWORKS=polygon,bsc
EVAL_TOKEN=USDT
EVAL_AMOUNT=0.50
EVAL_RUNS=4
EVAL_WARMUP_RUNS=0
EVAL_REPEATS=1
EVAL_CONCURRENCY=2
EVAL_TIMEOUT_MS=600000
EVAL_POLL_INTERVAL_MS=1000
EVAL_TARGET_READY_MS=6000
EVAL_RECONCILIATION_DELAY_MS=5000
# Requires a 10% Paystack balance buffer above the estimated payout principal.
EVAL_PAYOUT_BALANCE_BUFFER_BPS=11000
EVAL_LIVE=false
EVAL_OUTPUT_DIR=evaluation-results
EVAL_MERCHANT_ID=
MERCHANT_ACCOUNT_NUMBER=
MERCHANT_BANK_CODE=
TREASURY_PRIVATE_KEY=
POLYGON_TREASURY_PRIVATE_KEY=
BSC_TREASURY_PRIVATE_KEY=

# Optional password for the Grafana container. Used only with the
# `observability` Docker Compose profile.
GRAFANA_ADMIN_PASSWORD=gateway-demo

INVOICE_TTL_MINUTES=30
RECONCILE_INTERVAL_MS=3600000
DLQ_MAX_ATTEMPTS=5
